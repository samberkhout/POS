# Server
PORT=3000
LOCAL_NETWORK_CIDR=192.168.1.0/24

# Adyen Terminal API (Pin betaling)
ADYEN_API_KEY=your_adyen_api_key
ADYEN_MERCHANT_ACCOUNT=your_merchant_account
ADYEN_POIID=V400m-123456789
ADYEN_ENVIRONMENT=test

# Adyen Checkout API (Online betaling)
ADYEN_CHECKOUT_API_KEY=your_checkout_api_key
ADYEN_CHECKOUT_CLIENT_KEY=test_XXXXXXXXXXXX
ADYEN_WEBHOOK_HMAC_KEY=your_hmac_key_hex

# Publieke URL (Cloudflare Tunnel)
PUBLIC_URL=https://bestel.jouwdomein.nl

# Printer (pad naar USB printer device)
PRINTER_DEVICE=/dev/usb/lp0
